# RISE frontend environment variables (Vite: only VITE_* are exposed to the browser)
#
# Setup:
#   Development: copy to `.env.local` OR rely on committed `.env.development`
#   Production:  committed `.env.production` + Vercel vars (see `.env.vercel.example`)
#
# Files (Vite load order):
#   .env.development     → `npm run dev`
#   .env.production      → `npm run build`
#   .env.local           → local overrides (gitignored, use for API keys)

VITE_API_BASE_URL=http://localhost:8081
VITE_GOOGLE_MAPS_API_KEY=
